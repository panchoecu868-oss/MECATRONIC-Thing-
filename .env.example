# Necesaria solo para la generación de imagen conceptual por IA en la etapa de Diseño.
# Conseguila en https://platform.openai.com/api-keys (requiere cuenta con billing activo).
# Cada imagen generada (DALL-E 3, 1024x1024, calidad standard) cuesta unos USD 0.04.
OPENAI_API_KEY=

# Necesaria para el Asistente IA (plan de acción y preguntas puntuales, en todas las etapas).
# Conseguila en https://console.anthropic.com/settings/keys.
# Usa el modelo Claude Opus 5; el costo depende de lo que uses, facturado a tu cuenta.
ANTHROPIC_API_KEY=
