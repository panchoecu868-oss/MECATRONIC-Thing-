# Necesaria solo para la generación de imagen conceptual por IA en la etapa de Diseño.
# Conseguila en https://platform.openai.com/api-keys (requiere cuenta con billing activo).
# Cada imagen generada (DALL-E 3, 1024x1024, calidad standard) cuesta unos USD 0.04.
OPENAI_API_KEY=

# Necesaria solo para la generación de modelo 3D real por IA en la etapa de Diseño.
# Conseguila en tu cuenta de Meshy (app.meshy.ai, sección API/settings).
# Consume créditos de tu plan Meshy; el modo "preview" es el más barato/rápido (~30s-2min).
MESHY_API_KEY=
